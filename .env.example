# ==========================================
# Railway & Production Environment Variables
# ==========================================

# Port provided automatically by Railway at runtime (Defaults to 3000 if unset)
PORT=3000

# Secret API key for Colab XTTS worker authentication (Header: x-worker-api-key)
WORKER_API_KEY="voice_worker_7Kx92LmQ4pZ81X"

# Gemini API key (Required for AI script generation & voice synthesis)
GEMINI_API_KEY="your_gemini_api_key_here"

# Default Voice Provider ("xtts", "gemini", or "web_speech")
DEFAULT_VOICE_PROVIDER="xtts"

# Public App URL (Optional: Set on Railway to your generated railway.app domain)
APP_URL="https://your-app-name.up.railway.app"


